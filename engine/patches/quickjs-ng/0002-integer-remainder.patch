+/* A binary64 safe integer can be reduced exactly using its significand.
+   Fractional, non-finite and larger operands keep the general fmod path. */
+static bool js_float64_mod_int32(JSValue dividend, int32_t divisor,
+                               JSValue *result)
+{
+    JSFloat64Union u;
+    uint64_t significand, magnitude;
+    uint32_t exponent, modulus, remainder;
+    unsigned shift;
+    bool negative;
+
+    if (divisor == 0)
+        return false;
+    u.d = JS_VALUE_GET_FLOAT64(dividend);
+    exponent = (u.u64 >> 52) & 0x7ff;
+    if (exponent < 1023 || exponent > 1075)
+        return false;
+    shift = 1075 - exponent;
+    significand = (u.u64 & ((UINT64_C(1) << 52) - 1)) |
+                  (UINT64_C(1) << 52);
+    if (significand & ((UINT64_C(1) << shift) - 1))
+        return false;
+    magnitude = significand >> shift;
+    modulus = divisor < 0 ? 0U - (uint32_t)divisor : (uint32_t)divisor;
+    if (magnitude <= UINT32_MAX)
+        remainder = (uint32_t)magnitude % modulus;
+    else
+        remainder = magnitude % modulus;
+    negative = (u.u64 >> 63) != 0;
+    if (negative && remainder == 0)
+        *result = js_float64(-0.0);
+    else
+        *result = js_int32(negative ? -(int32_t)remainder : (int32_t)remainder);
+    return true;
+}
