{
  "name": "embedts-workspace",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm check:apps",
    "typecheck": "tsrs --noEmit --project tsconfig.json",
    "check:apps": "pnpm --filter \"./examples/**\" -r check",
    "build:apps": "python3 ../scripts/build_examples.py ../artifacts/apps"
  },
  "devDependencies": {
    "@embedts/builder": "workspace:*",
    "tsrs": "0.20.1-ts7.1.0-beta"
  }
}
